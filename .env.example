# Optional local XTTS voice cloning API settings
VOICE_API_PORT=8787
PYTHON_BIN=python3
VOICE_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
VOICE_CLONE_DEVICE=cpu
VOICE_CLONE_MAX_CHARS=24000
VOICE_CLONE_MAX_LINES=300
VOICE_CLONE_TIMEOUT_MS=1800000

# Set to 1 for API smoke tests without loading a model. This creates silent WAV output.
VOICE_CLONE_DRY_RUN=0

# Frontend override if not using the Vite proxy.
VITE_API_BASE_URL=
