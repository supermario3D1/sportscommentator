{
  "name": "sportscommentator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Consent-first AI sports commentary generator web app prototype.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node server/index.js",
    "voice:install": "python3 -m pip install -r server/voice/requirements.txt",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "multer": "^2.2.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "vitest": "latest"
  }
}
